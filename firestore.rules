rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow requests from Firebase Admin SDK
      return request.auth != null && request.auth.token.admin == true;
    }

    // ======= Public Collections =======

    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin() || (request.auth != null && resource.data.host.userUid == request.auth.uid);
    }

    // ======= User Collections =======

    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      match /profile/{profileId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

        match /availability/{availabilityId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }

        match /notifications/{notifId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }

        match /selectedCourts/{docId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }

        match /matches/{matchId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }
      }

      match /playmates/{playmateId} {
        allow read, write: if (request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == playmateId)) || isAdmin();
      }
    }

    match /users/{toUserUid}/profile/{toProfileId}/notifications/{notificationId} {
      allow create: if (request.auth != null &&
                    request.resource.data.keys().hasAll([
                      'id',
                      'type',
                      'fromUserUid',
                      'fromProfileId',
                      'isRead',
                      'status'
                    ]) &&
                    request.resource.data.fromUserUid == request.auth.uid &&
                    request.resource.data.status == "pending" &&
                    request.resource.data.type == "playmates request" &&
                    request.resource.data.isRead == false) || isAdmin();
    }

    // Collection group access to 'profile' for player discovery
    match /{documentPath=**}/profile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
