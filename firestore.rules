rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user is a participant in a players array
    function isParticipant(players) {
      return players.size() >= 1 && players[0].userUid == request.auth.uid ||
             players.size() >= 2 && players[1].userUid == request.auth.uid ||
             players.size() >= 3 && players[2].userUid == request.auth.uid ||
             players.size() >= 4 && players[3].userUid == request.auth.uid;
    }

    // ======= Public Collections =======

    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Matches: any authenticated user can create; only participants can update/delete
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.players.size() > 0 &&
        isParticipant(resource.data.players)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == profileId) || isAdmin();
    }

    // ======= Chat Collection =======

    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        resource.data.participantUids.hasAny([request.auth.uid]) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.participantUids.hasAny([request.auth.uid]) || isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
        allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuthenticated() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
      }
    }

    // ======= User Collections =======

    match /users/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

      match /profile/{profileId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

        match /availability/{availabilityId} {
          allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        }

        match /notifications/{notifId} {
          allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        }

        match /matches/{matchId} {
          allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        }
      }

      match /profiles/{profileId} {
        allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

        match /notifications/{notifId} {
          allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        }
      }

      match /playmates/{playmateId} {
        allow read, write: if (isAuthenticated() &&
          (request.auth.uid == userId || request.auth.uid == playmateId)) || isAdmin();
      }
    }

    // Extra profile rule
    match /users/{userId}/profiles/{profileId} {
      allow read: if isAuthenticated() || isAdmin();
    }

    match /users/{toUserUid}/profile/{toProfileId}/notifications/{notificationId} {
      allow create: if (isAuthenticated() &&
                    request.resource.data.keys().hasAll([
                      'id',
                      'type',
                      'fromUserUid',
                      'fromProfileId',
                      'isRead',
                      'status'
                    ]) &&
                    request.resource.data.fromUserUid == request.auth.uid &&
                    request.resource.data.status == "pending" &&
                    request.resource.data.type == "playmates request" &&
                    request.resource.data.isRead == false) || isAdmin();
    }

    // Collection group access to 'profile' — authenticated users only
    match /{documentPath=**}/profile/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() || isAdmin();
    }

    match /users/{userUid}/profile/{profileId}/selectedCourts/{docId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userUid) || isAdmin();
    }

    // Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
