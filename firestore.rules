rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow requests from Firebase Admin SDK
      return request.auth != null && request.auth.token.admin == true;
    }

    // ======= Public Collections =======

    match /courts/{courtId} {
      allow read: if true;
      // Only admins can create/update/delete court documents
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      // Any authenticated user can create a match as long as they are the host
      allow create: if request.auth != null && request.resource.data.host.userUid == request.auth.uid;
      // Allow any authenticated user to update for now (needed for players to join/update)
      allow update: if request.auth != null;
      // Only the host or an admin can delete a match
      allow delete: if request.auth != null && (request.auth.uid == resource.data.host.userUid || isAdmin());
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == profileId) || isAdmin();
    }

    // ======= User Collections =======

    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      match /profile/{profileId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

        match /availability/{availabilityId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }

        match /notifications/{notifId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }
      }

      match /profiles/{profileId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

        match /notifications/{notifId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }
      }

      match /playmates/{playmateId} {
        allow read, write: if (request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == playmateId)) || isAdmin();
      }
    }

    // Extra profile rule
    match /users/{userId}/profiles/{profileId} {
      allow read: if request.auth != null || isAdmin();
    }
     match /users/{userUid}/profile/{profileId}/matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid == userUid;
    }

    match /users/{toUserUid}/profile/{toProfileId}/notifications/{notificationId} {
      allow create: if (request.auth != null &&
                    request.resource.data.keys().hasAll([
                      'id',
                      'type',
                      'fromUserUid',
                      'fromProfileId',
                      'isRead',
                      'status'
                    ]) &&
                    request.resource.data.fromUserUid == request.auth.uid &&
                    request.resource.data.status == "pending" &&
                    request.resource.data.type == "playmates request" &&
                    request.resource.data.isRead == false) || isAdmin();
    }

    // Collection group access to 'profile'
    match /{documentPath=**}/profile/{profileId} {
      allow read: if true;
      // Global write access via collection group should be restricted to admins.
      // Individual users can still write to their own profile via the specific /users/{userId}/profile/{profileId} rule.
      allow write: if isAdmin();
    }

    match /users/{userUid}/profile/{profileId}/selectedCourts/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == userUid) || isAdmin();
    }

    // Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
