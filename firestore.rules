rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow requests from Firebase Admin SDK
      return request.auth != null && request.auth.token.admin == true;
    }

    // ======= Public Collections =======

    match /courts/{courtId} {
      allow read: if true;
      // 🛡️ Sentinel: Only admins can manage court information to prevent unauthorized tampering
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      // 🛡️ Sentinel: Secure match creation, update, and deletion
      // Only the host can create a match
      allow create: if request.auth != null && request.resource.data.host.userUid == request.auth.uid;
      // Only the host, participating players, or users joining an open match can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.host.userUid ||
        resource.data.players.exists(p, p.userUid == request.auth.uid) ||
        (resource.data.status == "open" && request.resource.data.players.exists(p, p.userUid == request.auth.uid))
      );
      // Only the host or an admin can delete a match
      allow delete: if request.auth != null && (request.auth.uid == resource.data.host.userUid || isAdmin());
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == profileId) || isAdmin();
    }

    // ======= User Collections =======

    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      match /profile/{profileId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

        match /availability/{availabilityId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }

        match /notifications/{notifId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }
      }

      match /profiles/{profileId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

        match /notifications/{notifId} {
          allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        }
      }

      match /playmates/{playmateId} {
        allow read, write: if (request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == playmateId)) || isAdmin();
      }
    }

    // Extra profile rule
    match /users/{userId}/profiles/{profileId} {
      allow read: if request.auth != null || isAdmin();
    }
     match /users/{userUid}/profile/{profileId}/matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid == userUid;
    }

    match /users/{toUserUid}/profile/{toProfileId}/notifications/{notificationId} {
      allow create: if (request.auth != null &&
                    request.resource.data.keys().hasAll([
                      'id',
                      'type',
                      'fromUserUid',
                      'fromProfileId',
                      'isRead',
                      'status'
                    ]) &&
                    request.resource.data.fromUserUid == request.auth.uid &&
                    request.resource.data.status == "pending" &&
                    request.resource.data.type == "playmates request" &&
                    request.resource.data.isRead == false) || isAdmin();
    }

    // Collection group access to 'profile'
    // 🛡️ Sentinel: Restrict collection group write access to admins.
    // Users can still manage their own profiles via specific user paths.
    match /{documentPath=**}/profile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userUid}/profile/{profileId}/selectedCourts/{docId} {
      allow read, write: if (request.auth != null && request.auth.uid == userUid) || isAdmin();
    }

    // Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
